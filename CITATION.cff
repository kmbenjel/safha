    given-names: Khalid
version: 0.1.0
date-released: 2026-11-13
license: MIT
repository-code: "https://github.com/kmbenjel/safha"
url: "https://warraq.benjelloun.dev/safha/"
keywords: [pdf, scanned books, deskew, crop, lossless, digital libraries, e-readers, Arabic]
